# Copy to .env. Replace ALL password placeholders before starting.
# Passwords must contain only ASCII letters, digits, underscore or hyphen (16+ characters).
MYSQL_ROOT_PASSWORD=replace_root_password_32chars
MYSQL_APP_PASSWORD=replace_app_password_32chars
MYSQL_PROJECTION_PASSWORD=replace_projection_password_32chars
MYSQL_READONLY_PASSWORD=replace_readonly_password_32chars
MYSQL_MIGRATION_PASSWORD=replace_migration_password_32chars
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local HTTP port; the backend Origin setting follows this value.
FRONTEND_PORT=8080
